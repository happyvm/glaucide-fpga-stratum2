# Arty A7-100T (Rev. D/E) constraints for the NTP server.
#
# Pin assignments verified against the Digilent master file
# Arty-A7-100-Master.xdc (github.com/Digilent/digilent-xdc, branch master,
# fetched 2026-11-17). Per-pin comparison in constraints/README.md.
# Vivado is not available in this environment: this file is NOT tool-checked.
# Port names follow the RTL (rx_er, not the master's eth_rxerr).

## Clock 100 MHz (master: line 7, E3 / IO_L12P_T1_MRCC_35)
set_property -dict {PACKAGE_PIN E3 IOSTANDARD LVCMOS33} [get_ports clk_100]
create_clock -period 10.000 -name clk_100 [get_ports clk_100]

## Ethernet PHY (DP83848J, MII mode). Master lines 181-199.
set_property -dict {PACKAGE_PIN C16 IOSTANDARD LVCMOS33} [get_ports eth_rstn]
set_property -dict {PACKAGE_PIN G18 IOSTANDARD LVCMOS33} [get_ports eth_ref_clk]
set_property -dict {PACKAGE_PIN F16 IOSTANDARD LVCMOS33} [get_ports eth_mdc]
set_property -dict {PACKAGE_PIN K13 IOSTANDARD LVCMOS33} [get_ports eth_mdio]
set_property -dict {PACKAGE_PIN F15 IOSTANDARD LVCMOS33} [get_ports eth_rx_clk]
set_property -dict {PACKAGE_PIN G16 IOSTANDARD LVCMOS33} [get_ports eth_rx_dv]
set_property -dict {PACKAGE_PIN C17 IOSTANDARD LVCMOS33} [get_ports eth_rx_er]
set_property -dict {PACKAGE_PIN D18 IOSTANDARD LVCMOS33} [get_ports {eth_rxd[0]}]
set_property -dict {PACKAGE_PIN E17 IOSTANDARD LVCMOS33} [get_ports {eth_rxd[1]}]
set_property -dict {PACKAGE_PIN E18 IOSTANDARD LVCMOS33} [get_ports {eth_rxd[2]}]
set_property -dict {PACKAGE_PIN G17 IOSTANDARD LVCMOS33} [get_ports {eth_rxd[3]}]
set_property -dict {PACKAGE_PIN H16 IOSTANDARD LVCMOS33} [get_ports eth_tx_clk]
set_property -dict {PACKAGE_PIN H15 IOSTANDARD LVCMOS33} [get_ports eth_tx_en]
set_property -dict {PACKAGE_PIN H14 IOSTANDARD LVCMOS33} [get_ports {eth_txd[0]}]
set_property -dict {PACKAGE_PIN J14 IOSTANDARD LVCMOS33} [get_ports {eth_txd[1]}]
set_property -dict {PACKAGE_PIN J13 IOSTANDARD LVCMOS33} [get_ports {eth_txd[2]}]
set_property -dict {PACKAGE_PIN H17 IOSTANDARD LVCMOS33} [get_ports {eth_txd[3]}]

# Optional inputs, driven by the PHY, not used by the RTL. The top level must
# declare these ports, otherwise get_ports finds nothing and Vivado reports an error.
set_property -dict {PACKAGE_PIN D17 IOSTANDARD LVCMOS33} [get_ports eth_col]
set_property -dict {PACKAGE_PIN G14 IOSTANDARD LVCMOS33} [get_ports eth_crs]

# The master file has no CONFIG_VOLTAGE / CFGBVS property: none is set here.

## Clocks
# PHY receive clock, 25 MHz (40 ns), driven by the PHY.
create_clock -period 40.000 -name eth_rx_clk [get_ports eth_rx_clk]
# PHY transmit clock, 25 MHz (40 ns), driven by the PHY.
create_clock -period 40.000 -name eth_tx_clk [get_ports eth_tx_clk]

# eth_ref_clk: 25 MHz output to the PHY, generated by an MMCM from clk_100.
# TODO: create_generated_clock on the MMCM CLKOUT pin, once the MMCM instance
# name is known (e.g. create_generated_clock -name eth_ref_clk -source
# [get_pins <mmcm>/CLKIN1] -divide_by 4 [get_pins <mmcm>/CLKOUT<n>]).
# Until then this net is not timed.

## MII timing, 100 Mb/s (DP83848J, datasheet SNLS250E rev. E)
# PHY -> FPGA: RXD, RX_DV and RX_ER are launched by the PHY on RX_CLK.
# Table T2.5.2: RX_CLK to RXD/RX_DV/RX_ER delay, 10 ns min, 30 ns max.
set_input_delay -clock eth_rx_clk -min 10.000 -max 30.000 \
    [get_ports {eth_rx_dv eth_rx_er eth_rxd[0] eth_rxd[1] eth_rxd[2] eth_rxd[3]}]

# FPGA -> PHY: TXD and TX_EN are launched on eth_tx_clk.
# Table T2.4.2 / T2.4.3: setup 10 ns, hold 0 ns before the TX_CLK edge.
# Output delay -max = external setup, -min = -(external hold).
# TODO: confirm the capturing edge (rising or falling) on figure 5-4 of SNLS250E.
set_output_delay -clock eth_tx_clk -max 10.000 \
    [get_ports {eth_tx_en eth_txd[0] eth_txd[1] eth_txd[2] eth_txd[3]}]
set_output_delay -clock eth_tx_clk -min 0.000 \
    [get_ports {eth_tx_en eth_txd[0] eth_txd[1] eth_txd[2] eth_txd[3]}]

# IOB TRUE: only takes effect if the top level registers these ports
# (input flop for rx, output flop for tx). Vivado ignores it otherwise.
set_property IOB TRUE [get_ports {eth_rx_dv eth_rx_er eth_rxd[0] eth_rxd[1] eth_rxd[2] eth_rxd[3]}]
set_property IOB TRUE [get_ports {eth_tx_en eth_txd[0] eth_txd[1] eth_txd[2] eth_txd[3]}]

# Board trace skew and PHY-side clock latency are not modelled.
# TODO: add them once the board layout is known.

## Clock domains
set_clock_groups -asynchronous -group clk_100 -group eth_rx_clk -group eth_tx_clk

# TODO: eth_mdc / eth_mdio (management interface, slow, bidirectional): no
# timing yet. Add set_false_path or a timing rule once the MDIO FSM exists.
